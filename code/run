#!/usr/bin/env bash
# Capsule entry point. Modes:
#
# export (default): make F0-network training data from every attached SLAP2
# session (GIAnT registration and SiLo, then exportF0TrainingData).
#   ./run [--mode export] [--giant_ref main] [--max_duration_s 900]
#         [--datasets all] [--n_workers 0] [--export_workers 8] [--channels 1]
#         [--keep_giant_outputs summary] [--compensate_online 1]
#         [--peak_method wmf] [--wmf_peakth 3] [--save_tif 0] [--stats 1]
#   giant_ref is the GIAnT-MATLAB commit/branch/tag whose fits define the
#   training target. max_duration_s caps each session (0: no cap). datasets
#   is "all" or comma-separated mount names. export_workers trials are
#   exported at once (at most n_workers; about 15 GB each). Reference stacks
#   are left out, and so is any session with an integration scan
#   (selectAcquisitionsSLAP2).
#   keep_giant_outputs: summary (trial_table + experiment_summary), all (adds
#   per_trial_summary) or none. compensate_online, peak_method and wmf_peakth
#   are GIAnT's compensateOnline (registration), peakMethod and wmfPeakth
#   (SiLo). save_tif 0 writes the registered movies as deflated HDF5 (lossless,
#   much smaller). stats 1 then stores each trial's stats next to it
#   (`slap2-f0 stats`). logs/disk_usage.txt follows disk and memory use every minute.
#
# disktest: how far /root/capsule/results grows: writes 10 GB files up to
#   --disk_gb (default 1500) or the first failure, logging df after each
#   (logs/disktest.txt), then deletes them.
#
# probe: peak GPU memory and time per step over a grid of model settings
#   (--train_args holds probe options, e.g. "--batches 2,4 --widths 32").
#
# train: train the blind-spot network on the exported trials found anywhere
# under the attached data assets (results of export runs), on the GPU if
# there is one.
#   ./run --mode train [--train_args "--data sim --steps 4000 ..."]
#         [--finetune_args "--data real --steps 2000 ..."]
#   train_args is passed to `slap2-f0 train` (see code/slap2_f0/cli.py), with
#   results in results/train. If finetune_args is given, a second training
#   then starts from results/train/best.pt (results in results/finetune),
#   e.g. simulation pretraining followed by fine-tuning on real residuals.
#   If eval_args is given (e.g. "--windows 192"), the best checkpoints are
#   then scored on every session (results/eval, see eval below).
#
# predict: full-trial baselines of saved checkpoints and SiLo for `slap2-f0 view`
#   ./run --mode predict --predict_args "--ckpt v6=/root/capsule/data/<run>/train/best.pt
#         --files <session>/Path1/trial_002"
#   predict_args is passed to `slap2-f0 predict`, with results in results/predict.
#
# eval: score saved checkpoints on each session's windows, real and simulated
# (e.g. a training run's results attached as a data asset).
#   ./run --mode eval --eval_args "--ckpt pre=/root/capsule/data/<run>/train/best.pt
#         --stats_from /root/capsule/data/<run>/train/stats --windows 192"
#   eval_args is passed to `slap2-f0 evaluate`, with results in results/eval.
#
# See README.md for the output formats.
set -uo pipefail

mode=export
giant_ref=main
max_duration_s=900
compensate_online=1
save_tif=0
peak_method=wmf
wmf_peakth=3
stats=1
disk_gb=1500
datasets=all
n_workers=0
export_workers=8
channels=1
keep_giant_outputs=summary
train_args=""
finetune_args=""
eval_args=""
predict_args=""

while [[ $# -gt 0 ]]; do
    case $1 in
        --*=*) name="${1#--}"; value="${name#*=}"; name="${name%%=*}"; shift ;;
        --*) name="${1#--}"; shift; value="${1-}"; [[ $# -gt 0 ]] && shift ;;
        *) shift; continue ;;
    esac
    case $name in
        mode|giant_ref|max_duration_s|datasets|n_workers|export_workers|channels|keep_giant_outputs|compensate_online|save_tif|peak_method|wmf_peakth|stats|disk_gb|train_args|finetune_args|eval_args|predict_args) printf -v "$name" '%s' "$value" ;;
        *) echo "Ignoring unknown parameter --$name" ;;
    esac
done

DATA=/root/capsule/data
RESULTS=/root/capsule/results
SCRATCH=/root/capsule/scratch
CODE=$(cd "$(dirname "$0")" && pwd)
mkdir -p "$RESULTS/logs" "$SCRATCH"
df -h /root/capsule/scratch /root/capsule/results /tmp 2>/dev/null | tee "$RESULTS/logs/disk.txt"

if [[ "$mode" == "train" ]]; then
    nvidia-smi 2>&1 | tee "$RESULTS/logs/nvidia-smi.txt" || true
    # shellcheck disable=SC2086  # train_args is a list of arguments
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True PYTHONPATH="$CODE" python3 -u -m slap2_f0.cli train "$DATA" --out "$RESULTS/train" $train_args \
        2>&1 | tee "$RESULTS/logs/train.log"
    status="${PIPESTATUS[0]}"
    [[ "$status" -ne 0 ]] && exit "$status"
    ckpts="pretrained=$RESULTS/train/best.pt"
    if [[ -n "$finetune_args" ]]; then
        # shellcheck disable=SC2086
        PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True PYTHONPATH="$CODE" python3 -u -m slap2_f0.cli train "$DATA" --out "$RESULTS/finetune" \
            --init "$RESULTS/train/best.pt" --stats_cache "$RESULTS/train/stats" $finetune_args \
            2>&1 | tee "$RESULTS/logs/finetune.log"
        status="${PIPESTATUS[0]}"
        [[ "$status" -ne 0 ]] && exit "$status"
        ckpts="$ckpts finetuned=$RESULTS/finetune/best.pt"
    fi
    if [[ -n "$eval_args" ]]; then  # then score the best checkpoints on every session
        # shellcheck disable=SC2086
        PYTHONPATH="$CODE" python3 -u -m slap2_f0.cli evaluate "$DATA" --out "$RESULTS/eval" --ckpt $ckpts \
            --stats_cache "$RESULTS/train/stats" $eval_args 2>&1 | tee "$RESULTS/logs/eval.log"
        status="${PIPESTATUS[0]}"
    fi
    exit "$status"
elif [[ "$mode" == "eval" ]]; then
    nvidia-smi 2>&1 | tee "$RESULTS/logs/nvidia-smi.txt" || true
    # shellcheck disable=SC2086  # eval_args is a list of arguments
    PYTHONPATH="$CODE" python3 -u -m slap2_f0.cli evaluate "$DATA" --out "$RESULTS/eval" $eval_args \
        2>&1 | tee "$RESULTS/logs/eval.log"
    exit "${PIPESTATUS[0]}"
elif [[ "$mode" == "predict" ]]; then
    nvidia-smi 2>&1 | tee "$RESULTS/logs/nvidia-smi.txt" || true
    # shellcheck disable=SC2086  # predict_args is a list of arguments
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True PYTHONPATH="$CODE" python3 -u -m slap2_f0.cli predict "$DATA" --out "$RESULTS/predict" $predict_args         2>&1 | tee "$RESULTS/logs/predict.log"
    exit "${PIPESTATUS[0]}"
elif [[ "$mode" == "probe" ]]; then
    # peak GPU memory and time per step over model settings; train_args here
    # are probe options (see `slap2-f0 probe --help`)
    nvidia-smi 2>&1 | tee "$RESULTS/logs/nvidia-smi.txt" || true
    # shellcheck disable=SC2086
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True PYTHONPATH="$CODE" python3 -u -m slap2_f0.cli probe --out "$RESULTS/probe" $train_args \
        2>&1 | tee "$RESULTS/logs/probe.log"
    exit "${PIPESTATUS[0]}"
elif [[ "$mode" == "disktest" ]]; then
    mkdir -p "$RESULTS/_disktest"
    n=0
    while (( n * 10 < disk_gb )); do
        if ! dd if=/dev/zero of="$RESULTS/_disktest/f$n" bs=64M count=160 oflag=direct status=none; then
            echo "$(date +%T) write of file $n failed" | tee -a "$RESULTS/logs/disktest.txt"
            break
        fi
        n=$((n + 1))
        echo "$(date +%T) $((n * 10)) GB written: $(df -BG --output=size,used,avail /root/capsule/results | tail -1)" | tee -a "$RESULTS/logs/disktest.txt"
    done
    rm -f "$RESULTS/_disktest"/f*
    rmdir "$RESULTS/_disktest"
    df -BG /root/capsule/results | tee -a "$RESULTS/logs/disktest.txt"
    exit 0
elif [[ "$mode" != "export" ]]; then
    echo "Unknown mode: $mode (use export, train, eval, predict, probe or disktest)"
    exit 2
fi

# GIAnT checkout: the image has a full clone; fetch newer commits when possible
dest="$SCRATCH/giant"
rm -rf "$dest"
git clone -q /opt/GIAnT-MATLAB "$dest"
git -C "$dest" fetch -q /opt/GIAnT-MATLAB '+refs/remotes/origin/*:refs/remotes/origin/*' --tags
git -C "$dest" remote set-url origin https://github.com/AllenNeuralDynamics/GIAnT-MATLAB.git
git -C "$dest" fetch -q origin '+refs/heads/*:refs/remotes/origin/*' --tags 2>/dev/null \
    || echo "Could not fetch GIAnT-MATLAB; using the refs in the image"
if git -C "$dest" rev-parse -q --verify "origin/$giant_ref^{commit}" >/dev/null; then
    git -C "$dest" checkout -q --detach "origin/$giant_ref"
else
    git -C "$dest" checkout -q --detach "$giant_ref"
fi
echo "GIAnT: $giant_ref -> $(git -C "$dest" rev-parse HEAD)"

# disk and memory use every minute (GIAnT's working files: up to ~225 MB per second
# of recording; 32 MATLAB workers ran out of memory on some 2026 sessions)
(while true; do echo "$(date +%T) $(df -BG --output=size,used,avail /root/capsule/results | tail -1) work $(du -sBG "$RESULTS/_work" 2>/dev/null | cut -f1) mem $(free -g | awk '/^Mem:/{print $3"G/"$2"G"}')"; sleep 60; done) \
    > "$RESULTS/logs/disk_usage.txt" 2>&1 &
disk_pid=$!

esc() { printf '%s' "${1//\'/\'\'}"; }
(cd "$CODE" && matlab -batch "run_export('giantDir','$dest','giantRef','$(esc "$giant_ref")','maxDuration_s','$max_duration_s','datasets','$(esc "$datasets")','nWorkers','$n_workers','exportWorkers','$export_workers','channels','$(esc "$channels")','keepGiantOutputs','$(esc "$keep_giant_outputs")','compensateOnline','$compensate_online','saveTif','$save_tif','peakMethod','$(esc "$peak_method")','wmfPeakth','$wmf_peakth','dataDir','$DATA','resultsDir','$RESULTS','scratchDir','$SCRATCH')") \
    2>&1 | tee "$RESULTS/logs/matlab.log"
status="${PIPESTATUS[0]}"
if [[ "$stats" == "1" ]]; then  # each trial's stats, next to it, for training
    PYTHONPATH="$CODE" python3 -u -m slap2_f0.cli stats "$RESULTS" --workers 16 2>&1 | tee "$RESULTS/logs/stats.log"
fi
kill "$disk_pid" 2>/dev/null
exit "$status"
